package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "libberberis_kernel_api_headers",
    defaults: [
        "berberis_all_hosts_defaults",
        "berberis_guest_agnostic_defaults",
    ],
    host_supported: true,
    export_include_dirs: ["include"],
}

cc_library_static {
    name: "libberberis_kernel_api_common",
    defaults: [
        "berberis_all_hosts_defaults",
        "berberis_guest_agnostic_defaults",
    ],
    host_supported: true,
    // TODO(b/346604197): Use the same set of sources on arm64 as on other archs once
    // runtime_primitives and guest_os_primitives are ported.
    arch: {
        arm64: {
            srcs: [
                "runtime_bridge_riscv64_to_arm64.cc",
            ],
        },
        riscv64: {
            srcs: [
                "open_emulation.cc",
                "runtime_bridge.cc",
                "sigevent_emulation.cc",
                "sys_mman_emulation.cc",
                "sys_prctl_emulation.cc",
            ],
            header_libs: [
                "libberberis_guest_os_primitives_headers",
            ],
        },
        x86: {
            srcs: [
                "open_emulation.cc",
                "runtime_bridge.cc",
                "sigevent_emulation.cc",
                "sys_mman_emulation.cc",
                "sys_prctl_emulation.cc",
            ],
            header_libs: [
                "libberberis_guest_os_primitives_headers",
            ],
        },
        x86_64: {
            srcs: [
                "open_emulation.cc",
                "runtime_bridge.cc",
                "sigevent_emulation.cc",
                "sys_mman_emulation.cc",
                "sys_prctl_emulation.cc",
            ],
            header_libs: [
                "libberberis_guest_os_primitives_headers",
            ],
        },
    },
    srcs: [
        "exec_emulation.cc",
        "fcntl_emulation.cc",
        "main_executable_real_path_emulation.cc",
        "sys_ptrace_emulation.cc",
        "unistd_emulation.cc",
    ],
    header_libs: [
        "libberberis_base_headers",
        "libberberis_kernel_api_headers",
    ],
    export_header_lib_headers: ["libberberis_kernel_api_headers"],
}

cc_library_static {
    name: "libberberis_kernel_api_riscv64",
    defaults: [
        "berberis_all_hosts_defaults_64",
    ],
    host_supported: true,
    // TODO(b/346604197): Use the same set of sources on arm64 as on other archs once
    // runtime_primitives and guest_os_primitives are ported.
    arch: {
        x86_64: {
            header_libs: [
                "libberberis_guest_os_primitives_headers",
            ],
            srcs: [
                "riscv64/open_emulation.cc",
            ],
        },
    },
    whole_static_libs: [
        "libberberis_kernel_api_common",
    ],
    srcs: [
        "riscv64/epoll_emulation.cc",
        "riscv64/syscall_emulation_arch.cc",
        "riscv64/syscall_emulation.cc",
    ],
    local_include_dirs: ["riscv64"],
    header_libs: [
        "libberberis_base_headers",
        "libberberis_guest_state_riscv64_headers",
        "libberberis_instrument_headers",
        "libberberis_kernel_api_headers",
    ],
    export_header_lib_headers: ["libberberis_kernel_api_headers"],
}

// region digitalis
cc_library_static {
    name: "libberberis_kernel_api_arm64",
    defaults: [
        "berberis_arm64_defaults",
    ],
    host_supported: true,
    arch: {
        x86_64: {
            srcs: [
                "arm64/open_emulation.cc",
                "open_emulation.cc",
                "runtime_bridge.cc",
                "sigevent_emulation.cc",
                "sys_mman_emulation.cc",
                "sys_prctl_emulation.cc",
            ],
            header_libs: [
                "libberberis_guest_os_primitives_headers",
                "libberberis_guest_os_primitives_arm64_headers",
            ],
        },
    },
    srcs: [
        "exec_emulation.cc",
        "fcntl_emulation.cc",
        "main_executable_real_path_emulation.cc",
        "sys_ptrace_emulation.cc",
        "unistd_emulation.cc",
        "arm64/epoll_emulation.cc",
        "arm64/syscall_emulation_arch.cc",
        "arm64/syscall_emulation.cc",
    ],
    local_include_dirs: ["arm64"],
    header_libs: [
        "libberberis_base_headers",
        "libberberis_guest_state_arm64_headers",
        "libberberis_instrument_headers",
        "libberberis_kernel_api_headers",
        "libberberis_runtime_primitives_headers",
    ],
    export_header_lib_headers: ["libberberis_kernel_api_headers"],
}

cc_test_library {
    name: "libberberis_kernel_api_arm64_unit_tests",
    defaults: ["berberis_test_library_defaults_64"],
    srcs: [
        "arm64/futex_eintr_test.cc",
        "arm64/mmap_bss_zero_test.cc",
        "arm64/seccomp_neuter_test.cc",
    ],
    header_libs: [
        "libberberis_base_headers",
        "libberberis_guest_os_primitives_headers",
        "libberberis_guest_state_arm64_headers",
        "libberberis_kernel_api_headers",
    ],
}
// endregion
