package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "libberberis_heavy_optimizer_arm64_headers",
    defaults: ["berberis_defaults_64"],
    host_supported: true,
    export_include_dirs: ["include"],
    header_libs: [
        "libberberis_assembler_headers",
        "libberberis_guest_state_arm64_headers",
    ],
    export_header_lib_headers: [
        "libberberis_assembler_headers",
        "libberberis_guest_state_arm64_headers",
    ],
}

// The ARM64 optimizing frontend lowers the ARM64 decoder's SemanticsPlayer
// callbacks into guest-agnostic x86_64 MachineIR (mirroring
// heavy_optimizer/riscv64/Android.bp). Integer/branch/load-store, scalar FP,
// and a broad NEON/SIMD subset translate for real; anything unhandled bails
// to the lite translator/interpreter.
//
// inline_intrinsic.h / call_intrinsic.h drive the guest-agnostic
// intrinsic->x86_64-SSE lowering (ProcessBindings). That machinery and the
// host x86_64 intrinsic implementations live in the riscv64 intrinsics header
// set (intrinsics-inl.h / intrinsics_process_bindings-inl.h / macro_assembler.h
// are host code-generation, not guest code), so the ARM64 backend reuses
// libberberis_intrinsics_riscv64_headers as the shared host intrinsic emitter -
// exactly as libberberis_backend_headers_arm64_to_x86_64 already reuses the
// riscv64 macro-assembler header set.
cc_library_static {
    name: "libberberis_heavy_optimizer_arm64",
    defaults: ["berberis_defaults_64"],
    host_supported: true,
    local_include_dirs: ["."],
    header_libs: [
        "libberberis_base_headers",
        "libberberis_backend_headers_arm64_to_x86_64",
        "libberberis_decoder_arm64_headers",
        "libberberis_guest_state_arm64_headers",
        "libberberis_heavy_optimizer_arm64_headers",
        "libberberis_intrinsics_riscv64_headers",
        "libberberis_runtime_primitives_headers",
    ],
    srcs: [
        "frontend.cc",
        "heavy_optimize_region.cc",
    ],
}

cc_test_library {
    name: "libberberis_heavy_optimizer_arm64_unit_tests",
    defaults: ["berberis_test_library_defaults_64"],
    local_include_dirs: ["."],
    header_libs: [
        "berberis_test_utils_headers",
        "libberberis_backend_headers_arm64_to_x86_64",
        "libberberis_base_headers",
        "libberberis_decoder_arm64_headers",
        "libberberis_guest_state_arm64_headers",
        "libberberis_heavy_optimizer_arm64_headers",
        "libberberis_interpreter_arm64_headers",
        "libberberis_intrinsics_riscv64_headers",
        "libberberis_lite_translator_headers",
        "libberberis_runtime_primitives_headers",
    ],
    srcs: [
        "frontend_tests.cc",
        "heavy_differential_fuzz_tests.cc",
        "heavy_memory_differential_fuzz_tests.cc",
        "tier_coverage_test.cc",
    ],
}
