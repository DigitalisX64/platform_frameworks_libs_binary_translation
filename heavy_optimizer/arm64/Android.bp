package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "libberberis_heavy_optimizer_arm64_headers",
    defaults: ["berberis_defaults_64"],
    host_supported: true,
    export_include_dirs: ["include"],
    header_libs: [
        "libberberis_assembler_headers",
        "libberberis_guest_state_arm64_headers",
    ],
    export_header_lib_headers: [
        "libberberis_assembler_headers",
        "libberberis_guest_state_arm64_headers",
    ],
}

// Phase 0: the optimizing frontend is not implemented yet, so this lib builds
// only the bail-out HeavyOptimizeRegion entry point. Later phases add
// frontend.{h,cc} + the MachineIR backend dependencies (mirroring
// heavy_optimizer/riscv64/Android.bp).
cc_library_static {
    name: "libberberis_heavy_optimizer_arm64",
    defaults: ["berberis_defaults_64"],
    host_supported: true,
    local_include_dirs: ["."],
    header_libs: [
        "libberberis_base_headers",
        "libberberis_guest_state_arm64_headers",
        "libberberis_heavy_optimizer_arm64_headers",
    ],
    srcs: [
        "heavy_optimize_region.cc",
    ],
}
