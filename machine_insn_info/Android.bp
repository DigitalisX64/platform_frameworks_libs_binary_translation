package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_binary_host {
    name: "berberis_gen_reg_class",
    main: "gen_reg_class.py",
    srcs: ["gen_reg_class.py"],
    libs: ["gen_reg_class_lib"],
}

python_library_host {
    name: "gen_reg_class_lib",
    srcs: ["gen_reg_class_lib.py"],
}

filegroup {
    name: "libberberis_machine_insn_info_reg_class_gen_inputs_x86_32",
    srcs: ["x86_32/reg_class_def.json"],
}

filegroup {
    name: "libberberis_machine_insn_info_reg_class_gen_inputs_x86_64",
    srcs: ["x86_64/reg_class_def.json"],
}

genrule {
    name: "libberberis_machine_insn_info_reg_class_gen_headers_x86_32",
    out: ["berberis/machine_insn_info/x86_32/machine_reg_class-inl.h"],
    srcs: [":libberberis_machine_insn_info_reg_class_gen_inputs_x86_32"],
    tools: ["berberis_gen_reg_class"],
    cmd: "$(location berberis_gen_reg_class) $(out) $(in)",
}

genrule {
    name: "libberberis_machine_insn_info_reg_class_gen_headers_x86_64",
    out: ["berberis/machine_insn_info/x86_64/machine_reg_class-inl.h"],
    srcs: [":libberberis_machine_insn_info_reg_class_gen_inputs_x86_64"],
    tools: ["berberis_gen_reg_class"],
    cmd: "$(location berberis_gen_reg_class) $(out) $(in)",
}

cc_library_headers {
    name: "libberberis_machine_insn_info_headers",
    defaults: ["berberis_defaults"],
    host_supported: true,
    export_include_dirs: ["include"],
    header_libs: [
        "libberberis_assembler_headers",
        "libberberis_base_headers",
    ],
    generated_headers: [
        "libberberis_machine_insn_info_reg_class_gen_headers_x86_32",
        "libberberis_machine_insn_info_reg_class_gen_headers_x86_64",
    ],
    export_header_lib_headers: [
        "libberberis_assembler_headers",
        "libberberis_base_headers",
    ],
    export_generated_headers: [
        "libberberis_machine_insn_info_reg_class_gen_headers_x86_32",
        "libberberis_machine_insn_info_reg_class_gen_headers_x86_64",
    ],
}
