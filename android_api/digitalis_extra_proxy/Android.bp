// Separate companion library that ships Digitalis-side fast-path trampolines
// for libc and libm symbols not covered by the upstream proxy libraries. The
// upstream libberberis_proxy_libc / libberberis_proxy_libm cc_library_shared
// modules are NOT touched; the trampolines here register themselves with the
// global ProxyLibraryBuilder extras-registry via __attribute__((constructor)).
//
// Packaged as a cc_library_static and consumed by libberberis_arm64.so via
// `whole_static_libs` so the constructor is reachable at load time. This
// avoids the DT_NEEDED dependency cycle that would arise from a shared-lib
// arrangement (the new lib needs symbols from libberberis_arm64; if
// libberberis_arm64 also DT_NEEDED'd this lib, soong rejects the cycle).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "libberberis_digitalis_extra_proxy_arm64",
    host_supported: false,
    defaults: [
        "berberis_arm64_defaults",
    ],
    header_libs: [
        "libberberis_base_headers",
        "libberberis_guest_abi_arm64_headers",
        "libberberis_guest_loader_headers",
        "libberberis_guest_state_headers",
        "libberberis_jni_headers",
        "libberberis_proxy_loader_headers",
        "libberberis_runtime_primitives_headers",
        "jni_headers",
    ],
    srcs: [
        "digitalis_extra_libc_trampolines.cc",
        "digitalis_extra_libm_trampolines.cc",
        "digitalis_extra_libnativehelper_trampolines.cc",
        "digitalis_extra_libbinder_ndk_trampolines.cc",
        "digitalis_extra_libwebviewchromium_plat_support_trampolines.cc",
        "digitalis_host_call_redirect.cc",
    ],
    // Sources are #ifdef'd on __x86_64__ so non-x86_64 builds get an
    // empty static lib.
}
