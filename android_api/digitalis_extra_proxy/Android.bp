// Separate companion library that ships Digitalis-side fast-path trampolines
// for libc and libm symbols not covered by the upstream proxy libraries. The
// upstream libberberis_proxy_libc / libberberis_proxy_libm cc_library_shared
// modules are NOT touched; the trampolines here register themselves with the
// global ProxyLibraryBuilder extras-registry via __attribute__((constructor)).
//
// Packaged as a cc_library_static and consumed by libberberis_arm64.so via
// `whole_static_libs` so the constructor is reachable at load time. This
// avoids the DT_NEEDED dependency cycle that would arise from a shared-lib
// arrangement (the new lib needs symbols from libberberis_arm64; if
// libberberis_arm64 also DT_NEEDED'd this lib, soong rejects the cycle).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Named-trampoline override registry API (named_trampoline_override.h),
// consumed by the per-library override files compiled into the proxy
// cc_library_shared modules (e.g. libberberis_proxy_libOpenSLES).
cc_library_headers {
    name: "libberberis_digitalis_extra_proxy_headers",
    defaults: ["berberis_defaults"],
    host_supported: true,
    export_include_dirs: ["include"],
    header_libs: [
        "libberberis_runtime_primitives_headers",
    ],
    export_header_lib_headers: [
        "libberberis_runtime_primitives_headers",
    ],
}

cc_library_static {
    name: "libberberis_digitalis_extra_proxy_arm64",
    host_supported: false,
    defaults: [
        "berberis_arm64_defaults",
    ],
    header_libs: [
        "libberberis_base_headers",
        "libberberis_guest_abi_arm64_headers",
        "libberberis_guest_loader_headers",
        "libberberis_guest_state_headers",
        "libberberis_guest_state_arm64_headers",
        "libberberis_jni_headers",
        "libberberis_proxy_loader_headers",
        "libberberis_runtime_primitives_headers",
        "libberberis_digitalis_extra_proxy_headers",
        "jni_headers",
    ],
    srcs: [
        "named_trampoline_override.cc",
        "digitalis_extra_libc_trampolines.cc",
        "digitalis_extra_libm_trampolines.cc",
        "digitalis_extra_libnativehelper_trampolines.cc",
        "digitalis_extra_libbinder_ndk_trampolines.cc",
        "digitalis_extra_libcamera2ndk_trampolines.cc",
        "digitalis_extra_libegl_trampolines.cc",
        "digitalis_extra_libglesv2_trampolines.cc",
        "digitalis_extra_libnativewindow_trampolines.cc",
        "digitalis_extra_libwebviewchromium_plat_support_trampolines.cc",
        "digitalis_host_call_redirect.cc",
    ],
    // Sources are #ifdef'd on __x86_64__ so non-x86_64 builds get an
    // empty static lib.
}

// Host-side ground-truth verification of the libcamera2ndk shared-camera V2
// capture-callback marshalling (camera2ndk_shared_capture_callbacks.h). The
// shared-camera API is untestable on the Digitalis emulator (see
// a shared-session AIDL HAL), so the per-field WrapGuestFunction
// marshalling is verified here against the NDK header signatures by firing each
// wrapped callback through the guest runtime. Linked into berberis_arm64_host_tests.
cc_test_library {
    name: "libberberis_digitalis_extra_proxy_arm64_unit_tests",
    defaults: [
        "berberis_arm64_defaults",
    ],
    host_supported: true,
    header_libs: [
        "libberberis_base_headers",
        "libberberis_guest_abi_arm64_headers",
        "libberberis_guest_state_headers",
        "libberberis_guest_state_arm64_headers",
        "libberberis_proxy_loader_headers",
        "libberberis_runtime_primitives_headers",
        "libberberis_digitalis_extra_proxy_headers",
        "berberis_test_utils_headers",
    ],
    srcs: [
        "camera2ndk_shared_capture_callbacks_test.cc",
        "digitalis_extra_proxy_no_crash_test.cc",
        "named_trampoline_override.cc",
        "named_trampoline_override_test.cc",
    ],
    shared: {
        enabled: false,
    },
}
