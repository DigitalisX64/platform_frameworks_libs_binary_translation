package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// region digitalis - use berberis_proxy_library_defaults for arch-conditional selection
// Original:
// cc_library_shared {
//     name: "libberberis_proxy_libc",
//     defaults: [
//         "berberis_defaults_64",
//         "//frameworks/libs/native_bridge_support/android_api/libc:native_bridge_proxy_libc_defaults",
//     ],
//     header_libs: [
//         "libberberis_guest_abi_riscv64_headers",
//     ],
//     shared_libs: [
//         "libberberis_riscv64",
//         "liblog",
//     ],
// }
cc_library_shared {
    name: "libberberis_proxy_libc",
    defaults: [
        "berberis_proxy_library_defaults",
        "//frameworks/libs/native_bridge_support/android_api/libc:native_bridge_proxy_libc_defaults",
    ],
    arch: {
        x86_64: {
            srcs: [
                "realloc_probe.cc",
                "free_probe.cc",
            ],
            ldflags: [
                "-Wl,--wrap=realloc",
                "-Wl,--wrap=free",
            ],
        },
    },
}
// endregion

// region digitalis - host unit tests for the shared Scudo-header probe guard
// (scudo_header_probe.h) that free_probe.cc / realloc_probe.cc rely on. Linked
// into berberis_arm64_host_tests. Verifies the GWP-ASan guard-page skip against
// a real PROT_NONE guard page so the free/realloc wrappers can't reintroduce the
// underflow fault.
cc_test_library {
    name: "libberberis_proxy_libc_arm64_unit_tests",
    defaults: [
        "berberis_arm64_defaults",
    ],
    host_supported: true,
    header_libs: [
        "berberis_test_utils_headers",
    ],
    srcs: [
        "scudo_header_probe_test.cc",
    ],
    shared: {
        enabled: false,
    },
}
// endregion
