package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// region digitalis - use soong_config for arch-conditional proxy selection
soong_config_module_type_import {
    from: "frameworks/libs/binary_translation/Android.bp",
    module_types: ["berberis_cc_defaults"],
}

berberis_cc_defaults {
    name: "berberis_proxy_library_defaults",
    host_supported: false,
    header_libs: [
        "libberberis_guest_abi_headers",
        "libberberis_proxy_loader_headers",
    ],
    shared_libs: [
        "liblog",
    ],
    soong_config_variables: {
        translation_arch: {
            riscv64_to_x86_64: {
                defaults: ["berberis_defaults_64"],
                header_libs: ["libberberis_guest_abi_riscv64_headers"],
                shared_libs: ["libberberis_riscv64"],
            },
            arm64_to_x86_64: {
                defaults: ["berberis_arm64_defaults"],
                header_libs: ["libberberis_guest_abi_arm64_headers"],
                shared_libs: ["libberberis_arm64"],
            },
            conditions_default: {
                defaults: ["berberis_defaults_64"],
            },
        },
    },
}
// endregion
