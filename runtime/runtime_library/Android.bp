package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "libberberis_runtime_library_headers",
    defaults: [
        "berberis_enable_arm64_host_defaults",
        "berberis_guest_agnostic_defaults",
    ],
    host_supported: true,
    export_include_dirs: ["include"],
    header_libs: [
        "libberberis_guest_state_headers",
        "libberberis_runtime_primitives_headers",
    ],
    export_header_lib_headers: [
        "libberberis_guest_state_headers",
    ],
}

cc_defaults {
    name: "berberis_runtime_library_defaults",
    arch: {
        arm64: {
            srcs: ["runtime_library_arm64.cc"],
        },
        x86: {
            srcs: [
                "runtime_library_x86_32.cc",
                // Has _asm suffix in name because .cc and .S cannot share
                // the same name. They cause duplicate object files that break
                // the build.
                "runtime_library_x86_32_asm.S",
            ],
        },
        x86_64: {
            srcs: ["runtime_library_x86_64.cc"],
        },
        riscv64: {
            srcs: ["runtime_library_riscv64.cc"],
        },
    },
    header_libs: [
        "libberberis_base_headers",
        "libberberis_guest_os_primitives_headers",
        "libberberis_guest_state_headers",
        "libberberis_runtime_library_headers",
        "libberberis_runtime_primitives_headers",
    ],
    srcs: [
        "runtime_library.cc",
    ],
    // Targets using these defaults must provide the following guest-specific fields:
    // header_libs: ["libberberis_guest_state_<guest>_headers"],
}

cc_library_static {
    name: "libberberis_runtime_library_arm_or_arm64",
    defaults: [
        "berberis_runtime_library_defaults",
        "berberis_arm_or_arm64_defaults",
    ],
    host_supported: true,
    header_libs: ["libberberis_guest_state_arm_or_arm64_headers"],
}

cc_library_static {
    name: "libberberis_runtime_library_riscv64",
    defaults: [
        "berberis_runtime_library_defaults",
        "berberis_riscv64_defaults",
    ],
    host_supported: true,
    header_libs: ["libberberis_guest_state_riscv64_headers"],
}

// region digitalis
// The ARM64 guest's runtime library. Mirrors the riscv64 variant, but binds
// berberis_arm64_defaults and the ARM64 guest state so that
// runtime_library_x86_64.cc's entry/exit trampolines compute their offsetof()
// against the ARM64 ThreadState layout.
cc_library_static {
    name: "libberberis_runtime_library_arm64",
    defaults: [
        "berberis_runtime_library_defaults",
        "berberis_arm64_defaults",
    ],
    host_supported: true,
    header_libs: ["libberberis_guest_state_arm64_headers"],
}
// endregion
