package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "libberberis_program_runner",
    defaults: ["berberis_guest_agnostic_defaults"],
    host_supported: true,
    srcs: ["program_runner.cc"],
    export_include_dirs: ["include"],
    header_libs: [
        "libberberis_base_headers",
        "libberberis_guest_loader_headers",
        "libberberis_guest_state_headers",
        "libberberis_runtime_headers",
    ],
}

cc_defaults {
    name: "berberis_program_runner_riscv64_defaults",
    defaults: [
        "berberis_guest_agnostic_defaults_64",
    ],
    host_supported: true,
    static_libs: [
        "libberberis_base",
    ],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    arch: {
        x86_64: {
            static_libs: ["libberberis_program_runner"],
            shared_libs: ["libberberis_riscv64"],
        },
        arm64: {
            header_libs: [
                "libberberis_base_headers",
                "libberberis_guest_state_headers",
            ],
            // There is no libberberis_riscv64 for arm64 host yet, so we
            // build the program runner from individual static libraries.
            static_libs: [
                "libberberis_guest_state_riscv64",
                "libberberis_interpreter_riscv64",
                "libberberis_kernel_api_riscv64",
                "libberberis_tinyloader",
                "libberberis_intrinsics_riscv64",
            ],
        },
    },
}

filegroup {
    name: "berberis_binfmt_misc_srcs",
    srcs: ["main_binfmt_misc.cc"],
}

filegroup {
    name: "berberis_program_runner_main_srcs",
    srcs: ["main.cc"],
}

cc_binary {
    name: "berberis_program_runner_binfmt_misc_riscv64",
    defaults: ["berberis_program_runner_riscv64_defaults"],
    srcs: [":berberis_binfmt_misc_srcs"],
}

cc_binary {
    name: "berberis_program_runner_riscv64",
    defaults: [
        "berberis_enable_arm64_host_defaults",
        "berberis_program_runner_riscv64_defaults",
    ],
    srcs: [":berberis_program_runner_main_srcs"],
}

// region digitalis
// Digitalis: ARM64 guest, x86_64 host program runners. The defaults mirror
// berberis_program_runner_defaults but link libberberis_arm64 instead of
// libberberis_riscv64.
cc_defaults {
    name: "berberis_program_runner_defaults_arm64_to_x86_64",
    defaults: ["berberis_defaults_64"],
    host_supported: true,
    static_libs: [
        "libberberis_base",
        "libberberis_program_runner",
    ],
    shared_libs: [
        "libbase",
        "libberberis_arm64",
        "liblog",
    ],
}

cc_binary {
    name: "berberis_program_runner_binfmt_misc_arm64",
    defaults: ["berberis_program_runner_defaults_arm64_to_x86_64"],
    srcs: [":berberis_binfmt_misc_srcs"],
}

cc_binary {
    name: "berberis_program_runner_arm64",
    defaults: ["berberis_program_runner_defaults_arm64_to_x86_64"],
    srcs: [":berberis_program_runner_main_srcs"],
}
// endregion
